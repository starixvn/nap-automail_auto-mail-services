@using System.Collections.Generic;
@using Fanex.NAPReport.SMAReport.Business;
@using Fanex.Service.Core.Extensions;
@using fanexCommon = Fanex.Common;

<div>
    <div>
        Dear All,<br />
        <br />
    </div>
    <div>
        Please click on the following links to download the report files.</div>
    <br />
    @{
        DateTime currentTime = DateTime.Now;
        string timeToEncrypt = currentTime.ToString();
        string encryptText = fanexCommon.Cryptography.CfsEnCrypt(timeToEncrypt);
        string reportPath = AppSettings.DownloadUrl;
        string linkNapReport = AppSettings.NapReportURL;
    }
    @foreach (string fileName in @Model)
    {
        string encryptReportName = fanexCommon.Cryptography.CfsEnCrypt(fileName);
        string reportDownloadUrl = string.Format("{0}?time={1}&reportName={2}", reportPath, encryptText, encryptReportName);
        <a href="@reportDownloadUrl">@fileName</a><br /><br />
    }
    <div>Note: <span style="font-style: italic;">The links will be expired on @currentTime.AddMonths(1).ToShortFormatedDate().</span></div><br /><br />
    
    You also can access to <a href="@linkNapReport" target="_blank">Nap-Accounting Report</a> to download report. <br /><br />

    Your report is placed at Nap Accounting Report/Misc/Auto-Generated Reports.<br /><br />
 
    Please contact Starix IT if you can not access or download report.<br /><br />
    <div>
        Thanks & Regards,<br />
        <br />
        Starix IT.
    </div>
</div>