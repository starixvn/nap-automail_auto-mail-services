@using Fanex.Service.Core.Extensions; 
@using System.Collections.Generic; 
@using Fanex.NAPReport.TurnoverWatcher.Business.Model;
<div>
    <div>
        <br />
        Dear All,
        <br />
        <br />
        Please be notified that SMA(s) listed in the table below have reached the Maximum
        Turnover value.
        <br />
        <br />
        Please check and carry out timely actions accordingly
    </div>
    <br />    
        <table cellspacing="0" border="1" border="1" style="border-color: #CECCCD; border-style: coll;
            font-size: 9pt; font-family: Tahoma, Verdana, Sans-Serif;" rules="all">
            <thead>
                <tr style="color: black; font-weight: bold; height: 25px;">
                    <td align="center" style="background-color: #b8cce4; border: thin solid #CECCCD;">
                        Sport
                    </td>
                    <td align="center" style="background-color: #b8cce4; border: thin solid #CECCCD;">
                        League
                    </td>
                    <td align="center" style="background-color: #b8cce4; border: thin solid #CECCCD;">
                        Match ID
                    </td>
                    <td align="center" style="background-color: #b8cce4; border: thin solid #CECCCD;">
                        Event
                    </td>
                    <td align="center" style="background-color: #b8cce4; border: thin solid #CECCCD;">
                        Event Date
                    </td>
                    <td align="center" style="background-color: #b8cce4; border: thin solid #CECCCD;">
                        SMA Name
                    </td>
                    <td align="center" style="background-color: #b8cce4; border: thin solid #CECCCD;">
                        Currency
                    </td>
                    <td align="center" style="background-color: #b8cce4; border: thin solid #CECCCD;">
                        Member Turnover
                    </td>
                    <td align="center" style="background-color: #b8cce4; border: thin solid #CECCCD;">
                        Company Turnover
                    </td>
                    <td align="center" style="background-color: #b8cce4; border: thin solid #CECCCD;">
                        Max Turnover
                    </td>
                    <td align="center" style="background-color: #b8cce4; border: thin solid #CECCCD;">
                        Percentage Used
                    </td>
                </tr>
            </thead>
            <tbody>
                @foreach (TurnoverInfo data in @Model) {
                <tr style="color: black; height: 25px;">
                    <td align="center" style="text-align: center; border: thin solid #CECCCD;">
                        @data.MatchInfo.SportName
                    </td>
                    <td align="right" style="border: thin solid #CECCCD; color: #A74C00;
                        font-family: Tahoma,Geneva,sans-serif; font-size: 12px; font-weight: bold; text-align: center;">
                        @data.MatchInfo.LeagueName
                    </td>
                    <td align="right" style="text-align: center; border: thin solid #CECCCD;">
                        @data.MatchInfo.MatchId
                    </td>
                    <td align="right" style="font-weight: bold; text-align: center; border: thin solid #CECCCD;">
                        @data.MatchInfo.HomeName - vs - @data.MatchInfo.AwayName
                    </td>
                    <td align="right" style="text-align: center; border: thin solid #CECCCD;">
                        @data.MatchInfo.EventDate.ToShortDateString()
                    </td>
                    <td align="right" style="text-align: center; border: thin solid #CECCCD;">
                        @data.CustomerInfo.CustomerName
                    </td>
                    <td align="right" style="text-align: center; border: thin solid #CECCCD;">
                        @data.CustomerInfo.Currency
                    </td>
                    <td align="right" style="text-align: center; border: thin solid #CECCCD;">
                        @data.CustomerInfo.MemberTurnover.CurrencyFormat()
                    </td>
                    <td align="right" style="text-align: center; border: thin solid #CECCCD;">
                        @data.CustomerInfo.CompanyTurnover.CurrencyFormat()
                    </td>
                    <td align="right" style="text-align: center; border: thin solid #CECCCD;">
                        @data.CustomerInfo.MaxTurnover.CurrencyFormat()
                    </td>
                    <td align="right" style="border: thin solid #CECCCD;">
                        @if (data.CustomerInfo.PercentageUsed >= 100) {
                        <div style="width: 100px; text-align: center; border: 1px solid #7C98A4; color: #FFFFFF;
                            font-family: Tahoma,Geneva,sans-serif; font-weight: bold; float: left; margin-left: 9px;
                            font-size: 10px; background: repeat-x scroll 0 0 #FF0000;">
                            100%</div>
                        } else if (data.CustomerInfo.PercentageUsed >= 50) {
                        <table cellspacing="0" cellpadding="0" style="border: 1px solid rgb(124, 152, 164);
                            float: left; margin-left: 9px;">
                            <tbody>
                                <tr>
                                    <td style="width: @(data.CustomerInfo.PercentageUsed - 41) px; background: none no-repeat scroll 0% 0% rgb(214, 233, 255);
                                        padding-left: 41px; text-align: left; font-family: Arial, Verdana, Sans-Serif;
                                        font-size: 10px; font-weight: bold;">
                                        @(data.CustomerInfo.PercentageUsed) %
                                    </td>
                                    <td style="width: @(100 - data.CustomerInfo.PercentageUsed) px;">
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        } else {
                        <div>
                            @string.Empty</div>
                        }
                    </td>
                </tr>
                }
            </tbody>
        </table>
    
    <br />
    <br />
    <div>
        Regards.</div>
    <br />
    <p style="font-style: italic; font-weight: bold">
        <br />
        This is an auto-mail. Please do not reply.</p>
</div>