@using System; @using Fanex.NAPReport.NegativeBalanceByMatch.Business.Entities; @using Fanex.NAPReport.NegativeBalanceByMatch.Business.Helper.Implement;
@{ int index = 1; }
<div>
    <div>
        尊敬的客戶,<br />
        <br />
        Dear valued customer,
        <br />
        <br />
        以下列出為可能導致受影響會員的負數餘額。請查看。<br />
        <br />
        Here are matches that might have caused negative balance for customers listed below.
        Please kindly have a check.
    </div>
    @foreach (Match match in @Model) {
    <br />
    <br />
    if (index > 1) {
    <hr />
    } if (@match.MatchInfo.GroupId == 3) {
    <div style="font-weight: bold">
        賽事 @index- Outright: @match.MatchInfo.LeagueName
    </div>
    <br />
    <div>
        Outright Bet: @match.MatchInfo.HomeName</div>
    <br />
    <div>
        日期 - Date: @match.MatchInfo.EventDate.ToString("d")</div>
    <br />
    <div>
        Outright ID: @match.MatchInfo.MatchID</div>
    } else {
    <div style="font-weight: bold">
        賽事 @index- Match @index: @match.MatchInfo.HomeName vs @match.MatchInfo.AwayName</div>
    <br />
    <div>
        賽事日期 - Event Date: @match.MatchInfo.EventDate.ToString("d")</div>
    <br />
    <div>
        賽事碼 - Match Code: @match.MatchInfo.MatchCode</div>
    <br />
    <div>
        賽事ID- Match ID: @match.MatchInfo.MatchID</div>
    }
    <br />
    <br />
    <br />
    
        <table cellspacing="0" border="1" border="1" style="border-color: #CECCCD; border-style: Solid;
            font-size: 10pt; font-family: Tahoma, Arial, Verdana, Sans-Serif;" rules="all">
            @if (match.MatchInfo.GroupId == 3) {
            <thead>
                <tr style="color: black; font-weight: bold">
                    <td align="center" style="width: 40px; background-color: #7A97D1;">
                        #
                        <br />
                    </td>
                    <td align="center" style="background-color: #7A97D1; width: 200px">
                        結算時間-
                        <br />
                        Settlement time
                    </td>
                    <td align="center" style="background-color: #7A97D1; width: 200px">
                        動作-
                        <br />
                        Action
                    </td>
                    <td align="center" style="background-color: #7A97D1; width: 100px">
                        -
                        <br />
                        Result
                    </td>
                    <td align="center" style="width: 100px; background-color: #7A97D1;">
                        -
                        <br />
                        Remark
                    </td>
                </tr>
            </thead>
            <tbody>
                @if (match.MatchSettleLogList.Count == 0) {
                <tr style="color: black;">
                    <td colspan='5' align="center">
                        There is no data.
                    </td>
                </tr>
                } else { int count = 1; foreach (MatchSettleLog matchSettleLog in @match.MatchSettleLogList)
                {
                <tr style="color: black;">
                    <td align="center" style="width: 40px;">
                        @count
                    </td>
                    <td align="center" style="width: 200px">
                        @matchSettleLog.SettlementTime
                    </td>
                    <td align="center" style="width: 200px">
                        @matchSettleLog.Action
                    </td>
                    <td align="center" style="width: 100px">
                        @matchSettleLog.Result
                    </td>
                    <td align="center" style="width: 100px;">
                        @matchSettleLog.Remark
                    </td>
                </tr>
                count++; } }
            </tbody>
            } else {
            <thead>
                <tr style="color: black; font-weight: bold">
                    <td align="center" style="width: 40px; background-color: #7A97D1;">
                        #
                        <br />
                    </td>
                    <td align="center" style="background-color: #7A97D1; width: 200px">
                        結算時間-
                        <br />
                        Settlement time
                    </td>
                    <td align="center" style="background-color: #7A97D1; width: 200px">
                        動作-
                        <br />
                        Action
                    </td>
                    <td align="center" style="background-color: #7A97D1; width: 100px">
                        上半場比分-
                        <br />
                        HT Score
                    </td>
                    <td align="center" style="width: 100px; background-color: #7A97D1;">
                        全場比分-
                        <br />
                        FT Score
                    </td>
                </tr>
            </thead>
            <tbody>
                @if (match.MatchSettleLogList.Count == 0) {
                <tr style="color: black;">
                    <td colspan='5' align="center">
                        There is no data.
                    </td>
                </tr>
                } else { int count = 1; foreach (MatchSettleLog matchSettleLog in @match.MatchSettleLogList)
                {
                <tr style="color: black;">
                    <td align="center" style="width: 40px;">
                        @count
                    </td>
                    <td align="center" style="width: 200px">
                        @matchSettleLog.SettlementTime
                    </td>
                    <td align="center" style="width: 200px">
                        @matchSettleLog.Action
                    </td>
                    <td align="center" style="width: 100px">
                        @matchSettleLog.HTHomeScore - @matchSettleLog.HTAwayScore
                    </td>
                    <td align="center" style="width: 100px;">
                        @matchSettleLog.FinalHomeScore - @matchSettleLog.FinalAwayScore
                    </td>
                </tr>
                count++; } }
            </tbody>
            }
        </table>
    
    <br />
    <br />
    <div>
        受影響之會員名單- List of affected members
    </div>
    <br />
    
        <table cellspacing="0" border="1" border="1" style="border-color: #CECCCD; border-style: Solid;
            font-size: 10pt; font-family: Tahoma, Arial, Verdana, Sans-Serif;" rules="all">
            <thead>
                <tr style="color: black; font-weight: bold">
                    <td align="center" style="width: 40px; background-color: #7A97D1;">
                        序號<br />
                        No.
                    </td>
                    <td align="center" style="background-color: #7A97D1; width: 200px">
                        會員<br />
                        Members
                    </td>
                    <td align="center" style="background-color: #7A97D1; width: 200px">
                        余額<br />
                        Balance
                    </td>
                    <td align="center" style="background-color: #7A97D1; width: 100px">
                        貨幣<br />
                        Currency
                    </td>
                    @if(match.LicenseeName.ToUpper() == "HAIFA") {
                    <td align="center" style="width: 100px; background-color: #7A97D1;">
                        廳註<br />
                        Custominfo1
                    </td>
                    } else {
                    <td align="center" style="width: 100px; background-color: #7A97D1;">
                        廳註<br />
                        Deposit Name
                    </td>
                    }
                </tr>
            </thead>
            <tbody>
                @if (match.MatchSettleLogList.Count == 0) {
                <tr style="color: black;">
                    <td colspan='5' align="center">
                        There is no data.
                    </td>
                </tr>
                } else { int count = 1; foreach (CustomerBalanceInfo customer in @match.CustomerInfoList)
                {
                <tr style="color: black;">
                    <td align="center" style="width: 40px;">
                        @count
                    </td>
                    <td align="right" style="width: 200px">
                        @customer.Username
                    </td>
                    <td align="right" style="width: 200px">
                        @customer.TotalBalance.Format(2)
                    </td>
                    <td align="right" style="width: 100px">
                        @customer.CurrencyName
                    </td>
                    <td align="right" style="width: 100px;">
                        @customer.CustomInfo1
                    </td>
                </tr>
                count++; } }
            </tbody>
        </table>
    
    index++; }
    <br />
    <div>
        Regards.</div>
    <br />
    <div>
        注: 此報告並不列出導致負數餘額之原因。此郵件為自動發送郵件。請勿回覆。</div>
    <p style="font-style: italic">
        Notes : Please be notified there is no reason stated for negative balance found
        in the report.
        <br />
        This is an auto-mail. Please do not reply.</p>
</div>
