@using Fanex.NAPReport.GameWinLimitControl.Business.Model;
@using Fanex.NAPReport.GameWinLimitControl.Business.Helper

@{
    var _model = Model;
    var index = 0;
    var indexGame = 0;
}
<div>
    <div>
        Dear All,<br /><br />
        
        
        Please be notified that Account(s) listed on below table have reached the Win Limit value. <br/>
        Please check and carry out timely actions accordingly.
    </div>
    <br/>
   <table cellspacing="0" rules="all" border="1" id="display" style="border-color:#c5c5c5; border-style:Solid;border-collapse:collapse;font-size:10pt; font-family:Tahoma, Arial, Verdana, Sans-Serif;">
        <thead>
            <tr style="height: 25px;background-color:#3C5EA5; color: #FFFFFF; font-weight: bold;">
                <th style="width:30px;">#</th>
                <th style="width:120px;">Username</th>
                <th style="width:120px;">Currency</th>
                <th style="width:200px;">Win Limit</th>
                <th style="width:200px;">Winning Amount</th>
                <th style="width:120px;">Percentage Used</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in _model)
            {

                int numberOfMembersBlockedSuccessful = item.Members.Count(s => s.BlockStatus == true);
                if (numberOfMembersBlockedSuccessful == 0)
                {
                    continue;
                }

                indexGame++;
                <tr style="height: 25px; font-size:9pt; font-family:Tahoma, Arial, Verdana, Sans-Serif; font-weight:bold">
                    <td style="text-align:left;" colspan="6" >@indexGame -  @item.ProductName</td>                    
                </tr>
                
                index = 0;
                foreach (var member in @item.Members)
                {
                    if (!member.BlockStatus)
                    {
                        continue;
                    }

                    index ++;
                    <tr style="height: 25px; font-size:9pt; font-family:Tahoma, Arial, Verdana, Sans-Serif;">
                        <td style="text-align:center;">@index </td>
                        <td style="text-align:center;">@member.Username</td>
                        <td style="text-align:center;">@member.Currency</td>
                        <td style="text-align:right;">@NumberExtensions.DoubleNumberFormat(@member.MaxWinLimit)</td>
                        <td style="text-align:right;">@NumberExtensions.DoubleNumberFormat(@member.TotalWinAmt)</td>
                        <td style="text-align:right; color:Red">@NumberExtensions.PercentFormat(@member.Percentage)</td>
                    </tr>
                }
            }
           
        </tbody>
   </table>
   <br />
    <div>
        Regards,<br /><br />
        This is an atuo-mail. Please do not reply.
    </div>
</div>
