@using Fanex.NAPReport.RngCasino.Business
@using Fanex.NAPReport.RngCasino.Business.Helper.Implement
@{ int index = 0; }  
<div>
    <div>
        Dear All,<br /> <br/>
        Please be informed that here's the list of members that win/lose greater or equal @AppSettings.BaseCurrency$@NumberExtension.WinLossFormat(@AppSettings.WinLoss, 0)<br />
    </div>
    <br/>
    <table cellspacing="0" rules="all" border="1" id="display" style="border-color:#c5c5c5; border-style:Solid;border-collapse:collapse;font-size:10pt; font-family:Tahoma, Arial, Verdana, Sans-Serif;">
        <thead>
            <tr style="height: 25px;background-color:#3C5EA5; color: #FFFFFF; font-weight: bold;">
                <th align="center" style="width: 40px;">
                    Index
                </th>
                <th align="center" style="width: 150px">
                    Member
                </th>
                <th align="center" style="width: 120px">
                    Agency
                </th>
                <th align="center" style="width: 150px">
                   Winloss Amount in @AppSettings.BaseCurrency
                </th>
                <th align="center" style="width: 220px">
                   Winloss Amount in user currency (UserCurrency)
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var customer in @Model)
            {
                index++;
                <tr style="height: 25px;">
                    <td align="center" style="width: 40px">
                        @index
                    </td>
                    <td align="center" width="150px">
                        @customer.Member
                    </td>
                    <td align="center" width="120px">
                        @customer.Agency
                    </td>
                    <td align="right" style="width: 150px">
                        @NumberExtension.WinLossFormat(@customer.WinlossBaseCurrency, 2)
                    </td>
                    <td align="right" style="width: 220px">
                       @NumberExtension.WinLossFormat(@customer.Winloss, 2) <span>(@customer.CurrencyName)</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>    
    <br/>
    <div>
    <p style="font-style: italic">Please do not reply directly to this email. It was sent from an unattended mailbox.<br/>
    Thanks & Regards,<br/>
    Automail System</p>
</div>
