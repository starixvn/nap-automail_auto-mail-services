  <NapSettings Environment="LIVE" IsSiteLogin="1" SiteId="4" LBUrl="tcp://10.40.40.150:8990/UMControllerInterface" UM="true" UnauthorizeUrl="~/UserLogin/Common/AccessDenied" ReCheckin="true">
