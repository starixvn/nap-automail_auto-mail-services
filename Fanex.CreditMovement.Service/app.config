<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection,Fanex.Data" />
    <section name="NapSettings" type="Fanex.NAP.Core.Configuration.NapSettings, Fanex.NAP.Core" />
    <section name="Fanex.MailDelivery.Client" type="Fanex.MailDelivery.Client.Configurations.MailClientSection, Fanex.MailDelivery.Client" />
  </configSections>
  <NapSettings Environment="LIVE" IsSiteLogin="1" SiteId="4" LBUrl="tcp://10.40.40.150:8990/UMControllerInterface" UM="true" UnauthorizeUrl="~/UserLogin/Common/AccessDenied" ReCheckin="true">
    <Domain>
      <add Name="58.86.55.10" Path="/AccReport"></add>
    </Domain>
  </NapSettings>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider2,Fanex.Data" resourcePath="App_Data/" enableWatching="1" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <Fanex.Logging msmqPath="FormatName:DIRECT=TCP:10.18.200.209\private$\entlib" defaultCategory="Accounting-Local" />
  <appSettings>
    <add key="ServiceName" value="_Fanex.CreditMovement.Service" />
    <add key="Interval.Second" value="10" />
    <add key="RemoteRefURL" value="tcp://10.18.200.209:8888/CallGetRefFunction" />
    <add key="ForceRunning" value="0" />
    <add key="ForceRunningFromDate" value="09-01-2013" />
    <add key="ForceRunningToDate" value="09-01-2013" />
    <!--MM-DD-YYYY-->
    <add key="RunAtHours" value="1" />
    <add key="RunAtMinutes" value="0" />
    <add key="RunNextTimeInMinutes" value="10" />
    <add key="SQLiteDBPath" value="Data Source=D:\SQLite\NAP-Report\AutoMail-CreditMovementReport.s3db;Version=3;" />
    <add key="app_mail_address" value="net.tcp://10.18.200.209:8787/MailService" />
    <add key="app_mail_id" value="1" />

    <add key="CreditMovement.FromDate" value="2015-03-01" />
    <add key="CreditMovement.ToDate" value="2015-03-16" />
    <add key="CreditMovement.Subject" value=" Automail report - Credit Movement Report From {0} to {1}" />
    <add key="CreditMovement.Title" value="IT Team" />
    <!--<add key="CreditMovement.ExportDataDirectory" value="\\10.18.200.202\_Fanex.ExcelFiles\CreditMovement"/>-->
    <add key="CreditMovement.ExportDataDirectory" value="E:\Z_ExcelFiles\CreditMovement" />
    <add key="CreditMovement.EmailTemplate" value="SiteConfig/CreditMovement/Email.cshtml" />
    <add key="CreditMovement.Amount" value="0" />
  </appSettings>
  <connectionStrings>
    <add name="DBLOG.bodb_CustomerLog.bodbAdminNet" connectionString="packet size=4096; Data Source=10.18.200.215;Asynchronous Processing=true;Initial Catalog=bodb_CustomerLog;integrated security=false; user id=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr=" providerName="System.Data.SqlClient" />
    <add name="DBACC.bodb02.bodbAdminNet" connectionString="packet size=4096; Data Source=10.18.200.215;Asynchronous Processing=true;Initial Catalog=bodb02;integrated security=false; user id=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr=" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="NPOI" publicKeyToken="0DF73EC7942B34E1" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.6.0" newVersion="2.0.6.0" />
